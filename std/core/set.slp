; A set of keys, which is a map whose values carry nothing.
;
; It is a `(Map T bool)` and not a machine of its own, because a set is what a
; map is when the answer is only whether the key is there. The `bool` stored
; against every key is always `true` and nothing reads it; what does the work
; is that `insert` keeps one entry per key (`D-104`).
;
; Like a map, everything that writes consumes the set and gives it back.

(take core:map Map new insert lookup contains delete size fold)

(export Set of add holds discard count each)

(struct Set (T) ((entries (Map T bool))))

(fn of (T) ((hash (Fn ((& T)) i64)) (same (Fn ((& T) (& T)) bool))) -> (Set T)
  (Set :entries (new hash same)))

(fn add (T) ((set (Set T)) (key T)) -> (Set T)
  (match set
    ((Set :entries entries) (Set :entries (insert entries key true)))))

(fn holds (T) ((set (& (Set T))) (key (& T))) -> bool
  (match set
    ((Set :entries entries) (contains entries key))))

(fn discard (T) ((set (Set T)) (key (& T))) -> (Set T)
  (match set
    ((Set :entries entries) (Set :entries (delete entries key)))))

(fn count (T) ((set (& (Set T)))) -> i64
  (match set
    ((Set :entries entries) (size entries))))

; The set's `fold`, with the value the map carries left out of it: a caller
; folding over a set has no use for a `(& bool)` that is always true.
(fn each (T A) ((set (& (Set T))) (start A) (step (Fn (A (& T)) A))) -> A
  (match set
    ((Set :entries entries)
      (fold entries start
        (lambda (step) ((carried A) (key (& T)) (value (& bool))) -> A
          (step carried key))))))
