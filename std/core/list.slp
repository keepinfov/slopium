; Lists, over function values.
;
; The list itself is built into the language; this is what you do with one. It
; is `core` (`D-083`): a `(List T)` is the runtime's `SlList`, which needs an
; allocator and not an operating system.
;
; **Two shapes of function, and the reason there are two.** A function that
; consumes each element takes the element — `map` and `fold`. A function that
; only wants to *look* at one takes a borrow of it — `filter`, `find` and
; `sort-by`. That is the whole distinction, and it is the ownership the language
; already has rather than a convention on top of it.
;
; Until v0.7.3 these three took the borrowed list *and an index*, on the grounds
; that there was no way to read a `(& T)`. That was true of this module's own
; body and irrelevant to its callers: a predicate is written by someone who
; knows what `T` is, and handing one a `(& T)` has always worked. The
; convention was a workaround for a hole that was not there, it was about to be
; frozen at v0.9, and deleting it is most of why v0.7.3 exists (`D-099`).
;
; Every consuming function removes from the front, which is a move of the rest
; of the list each time. That is quadratic, and it is the honest first version:
; fixing it is a `reverse` and a second pass, and it changes no signature here.

(take core:option Option)
(take core:panic assert)

(export map filter fold find sort-by insert swap clear truncate)

; `f` is handed each element in order and owns it. This is the one function
; here that can return a list of a different type, and therefore the one that
; needs `(list)` to mean an empty `(List U)` — there is no input to hand back
; when there is nothing to map (`D-096`).
(fn map (T U) ((items (List T)) (f (Fn (T) U))) -> (List U)
  (let mut input items)
  (if (= (len &input) 0)
    (list)
    (let head (remove &mut input 0))
    (let mut output (list (f head)))
    (while (> (len &input) 0)
      (let next (remove &mut input 0))
      (push &mut output (f next)))
    output))

; `keep` is asked about each element of the list as it arrived, before anything
; is removed, which is why every question is answered first and the removals
; happen afterwards and from the back.
(fn filter (T) ((items (List T)) (keep (Fn ((& T)) bool))) -> (List T)
  (let mut result items)
  (let size (len &result))
  (if (= size 0)
    result
    (let mut flags (list (keep (get-ref &result 0))))
    (let mut index 1)
    (while (< index size)
      (push &mut flags (keep (get-ref &result index)))
      (set index (+ index 1)))
    (let mut back size)
    (while (> back 0)
      (set back (- back 1))
      (when (not (get &flags back))
        (drop-at &mut result back)))
    result))

; Removing and discarding, as its own function because the discarded binding
; has to go out of scope for the loan to close.
(fn drop-at (T) ((items &mut (List T)) (index i64)) -> unit
  (let dropped (remove items index))
  ())

(fn fold (T A) ((items (List T)) (initial A) (f (Fn (A T) A))) -> A
  (let mut input items)
  (let mut total initial)
  (while (> (len &input) 0)
    (let head (remove &mut input 0))
    (set total (f total head)))
  total)

; The index of the first element `holds` accepts, like `core:string:find`
; returns the index of a match rather than the thing found. Returning the
; element would have to move it out of a list the caller still owns.
(fn find (T) ((items &(List T)) (holds (Fn ((& T)) bool))) -> (Option i64)
  (let size (len items))
  (let mut index 0)
  (let mut found -1)
  (while (< index size)
    (when (holds (get-ref items index))
      (set found index)
      (break))
    (set index (+ index 1)))
  (if (< found 0) (Option:None) (Option:Some found)))

; Writing into a list, which is `replace` (`D-103`) and the four things it
; makes possible. Every one of them takes the list exclusively and answers
; `unit`: what they change is the list they were handed.
;
; An index outside the list is a bug in the caller rather than an answer, so it
; ends the program the way an out-of-range `get` does (`D-146`). That is why
; this module takes `core:panic`, and it is the only thing it takes it for.

; Puts `value` at `index` and moves everything from there up one place. The
; displaced element is carried forward into the next slot, so each element is
; written once and the list grows by exactly one at the end.
(fn insert (T) ((items &mut (List T)) (index i64) (value T)) -> unit
  (let size (len items))
  (assert (and (>= index 0) (<= index size)) &"insert index out of bounds")
  (if (= index size)
    (push items value)
    (do
      (let mut carried (replace items index value))
      (let mut position (+ index 1))
      (while (< position size)
        (let displaced (replace items position carried))
        (set carried displaced)
        (set position (+ position 1)))
      (push items carried|)

; Exchanges two elements without moving anything else, which is what a sort
; needs and what the list could not do before.
;
; It is written around the last element because `replace` puts a value in and
; takes one out in the same breath, so a swap needs one element held outside
; the list to start the rotation with — and the last one is the only one that
; can leave without moving the rest.
(fn swap (T) ((items &mut (List T)) (left i64) (right i64)) -> unit
  (let size (len items))
  (assert (and (>= left 0) (< left size)) &"swap index out of bounds")
  (assert (and (>= right 0) (< right size)) &"swap index out of bounds")
  (when (!= left right)
    (let last (- size 1))
    ; `remove` at the last index and not `pop`, which answers an `Option` and
    ; so needs the `option` language item — which a `core` vendored as an
    ; ordinary package does not have (`D-146`). Removing the last element
    ; shifts nothing, so the two cost the same.
    (let held (remove items last))
    (if (or (= left last) (= right last))
      ; One of the two has already left, so it goes straight into the other's
      ; slot and what came out goes on the end.
      (do
        (let other (if (= left last) right left))
        (let displaced (replace items other held))
        (push items displaced))
      (do
        (let first (replace items left held))
        (let second (replace items right first))
        (let back (replace items left second))
        (push items back|)

; Drops every element from the back, so each one is released rather than
; forgotten. A list of owned values is the case that makes the difference.
(fn clear (T) ((items &mut (List T))) -> unit
  (truncate items 0))

(fn truncate (T) ((items &mut (List T)) (length i64)) -> unit
  (let mut remaining (len items))
  (while (> remaining length)
    (set remaining (- remaining 1))
    (let dropped (remove items remaining|)

; `before` answers whether the first element belongs ahead of the second. A sort
; parameterised by a function is what a language with traits gets from `Ord`,
; and this is the parametric answer to it (`D-088`). It is also where two
; borrows of the same list are alive at once, which shared borrows have always
; allowed and nothing in the library had asked for.
;
; Merge sort over the indices, and then the permutation applied in place with
; `swap` (`D-146`). Sorting the elements directly needs somewhere to put one
; while its slot is being filled, and an owned `T` has no value to leave
; behind; an index does, so the comparisons decide an order in a `(List i64)`
; and the elements are moved once each at the end.
;
; What this replaces was a selection sort that compared every remaining pair
; for every position and then moved each element out of the list with `remove`,
; so it was quadratic in comparisons and moved the tail of the list on every
; placement. Its own comment said a better algorithm needed a way to overwrite
; one element, which `replace` has been since `D-103`.
;
; `before` is strict and a tie takes from the left run, so equal elements keep
; the order they arrived in and the sort is stable.
(fn sort-by (T) ((items (List T)) (before (Fn (&T &T) bool))) -> (List T)
  (let mut sorted items)
  (let size (len &sorted))
  (if (< size 2)
    sorted
    (do
      (let order (sorted-order &sorted &before size))
      (apply-order &mut sorted &order)
      sorted)))

; The indices of the list in sorted order, merged bottom-up. Two index lists of
; the same length trade places on every pass, which is why one of them is a
; clone rather than something built empty: a `(List i64)` merged into has to
; have the slots already.
(fn sorted-order (T) ((items &(List T)) (before &(Fn (&T &T) bool)) (size i64))
  -> (List i64)
  (let mut current (list 0))
  (let mut index 1)
  (while (< index size)
    (push &mut current index)
    (set index (+ index 1)))
  (let mut scratch (clone &current))
  (let mut width 1)
  (while (< width size)
    (let span (* width 2))
    (let mut start 0)
    (while (< start size)
      (let middle (least (+ start width) size))
      (let end (least (+ start span) size))
      (merge-run items before &current &mut scratch start middle end)
      (set start (+ start span)))
    (let held current)
    (set current scratch)
    (set scratch held)
    (set width span))
  current)

(fn least ((left i64) (right i64)) -> i64
  (if (< left right) left right))

; One merge of two neighbouring runs, `[start, middle)` and `[middle, end)`,
; from `source` into the same range of `target`.
(fn merge-run (T)
  ((items &(List T))
    (before &(Fn (&T &T) bool))
    (source &(List i64))
    (target &mut (List i64))
    (start i64)
    (middle i64)
    (end i64))
  -> unit
  (let mut left start)
  (let mut right middle)
  (let mut at start)
  (while (< at end)
    (let from-left
      (if (>= left middle)
        false
        (if (>= right end)
          true
          ; Asked the other way round: the right element wins only if it comes
          ; strictly before the left one, so a tie takes from the left.
          (not
            (before (get-ref items (get source right))
                    (get-ref items (get source left)))))))
    (if from-left
      (do
        (let discarded (replace target at (get source left)))
        (set left (+ left 1)))
      (do
        (let discarded (replace target at (get source right)))
        (set right (+ right 1))))
    (set at (+ at 1|)

; `order` says which element belongs at each position, counted in the list as
; it arrived. Following each cycle forward puts one element home per `swap`, so
; the whole permutation costs at most one swap per element and no second list.
(fn apply-order (T) ((items &mut (List T)) (order &(List i64))) -> unit
  (let size (len order))
  (let mut at 0)
  (while (< at size)
    (let mut from (get order at))
    ; A source below `at` has already been swapped away; where it went is what
    ; the order says about it.
    (while (< from at)
      (set from (get order from)))
    (when (!= from at)
      (swap items at from))
    (set at (+ at 1|)
