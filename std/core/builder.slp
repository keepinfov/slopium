; A string built once, out of a buffer that grows.
;
; This is `core` and not `std` (`D-083`): a buffer needs an allocator and not
; an operating system, so a freestanding program gets it.
;
; `concat` allocates a fresh `String` and copies both sides, so accumulating a
; document with `(set out (concat (& out) (& piece)))` copies everything written
; so far on every piece and is quadratic in the length of the result. A builder
; writes each piece into one buffer and allocates once, at the end (`D-145`).
;
; The buffer is a `(List u8)`. Every integer is one machine word wide whatever
; its type says, so that is a word per byte — the same shape `core:string`'s
; `from-bytes` already takes. Long pieces are copied in one runtime call
; (`sl_rt_builder_write_bytes`); short pieces skip the extra pass over the
; buffer. Growing the list still takes one `push` per byte (`D-124`).

(export Builder new write-str write-byte write-i64 write-u64 size build)

(struct Builder ((bytes (List u8|)

(extern "sl_rt_string_from_bytes" (bytes-raw (bytes &(Slice u8))) -> String)

(extern "sl_rt_string_byte" (byte-raw (text &String) (length i64) (index i64)) -> i64)

; The words are already there — `write-str` grows the buffer first — and this
; fills the last of them. The string's length is explicit because `&String`
; crosses as a pointer alone and a piece may contain NUL (`D-079`).
(extern "sl_rt_builder_write_bytes"
  (write-bytes-raw (bytes &mut (List u8)) (text &String) (length i64))
  -> unit)

; The empty `(list)` takes its element type from the field being built, which
; is the same reason `core:map` builds its bucket array in the struct literal.
(fn new () -> Builder
  (Builder :bytes (list)))

(fn size ((builder &Builder)) -> i64
  (match builder
    ((Builder :bytes bytes) (len bytes|)

(fn write-byte ((into &mut Builder) (byte u8)) -> unit
  (match into
    ((Builder :bytes bytes) (push bytes byte|)

; C may not resize a list it was handed (`D-124`), so bulk copying needs a
; zero-filled tail first. For pieces of at most one word, the second pass and
; its extra call cost more than reading the source bytes directly.
(fn write-str ((into &mut Builder) (text &String)) -> unit
  (let width (len text))
  (let mut index 0)
  (if (<= width 8)
    (while (< index width)
      (write-byte into (as u8 (byte-raw text width index)))
      (set index (+ index 1)))
    (match into
      ((Builder :bytes bytes)
        (while (< index width)
          (push bytes (as u8 0))
          (set index (+ index 1)))
        (write-bytes-raw bytes text width|)

; The digits go in least significant first and come back out reversed, so a
; number costs one small list rather than one `String` per digit — which is
; what `core:string`'s `digits-of` costs, and why this is not written over it.
(fn write-u64 ((into &mut Builder) (value u64)) -> unit
  (if (= value 0)
    (write-byte into 48)
    (do
      (let mut digits (list (as u8 0)))
      (let discarded (remove &mut digits 0))
      (let mut remaining value)
      (while (> remaining 0)
        (push &mut digits (as u8 (+ 48 (as i64 (% remaining 10)))))
        (set remaining (/ remaining 10)))
      (let mut index (len &digits))
      (while (> index 0)
        (set index (- index 1))
        (write-byte into (get &digits index|)

; A sign and a magnitude. The magnitude of the smallest `i64` has no `i64` to
; hold it, so it is taken one below and put back as a `u64`, exactly as
; `core:string`'s `from-i64` does.
(fn write-i64 ((into &mut Builder) (value i64)) -> unit
  (if (< value 0)
    (do
      (write-byte into 45)
      (write-u64 into (+ (as u64 (- (+ value 1))) 1)))
    (write-u64 into (as u64 value|)

; The one allocation. The builder is consumed, because the bytes leave with the
; string and a buffer that has been handed over is not one to keep writing to.
(fn build ((builder Builder)) -> String
  (match builder
    ((Builder :bytes bytes)
      (let view (slice &bytes 0 (len &bytes)))
      (bytes-raw &view|)
