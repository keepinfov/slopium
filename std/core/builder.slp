; A string built once, out of a buffer that grows.
;
; This is `core` and not `std` (`D-083`): a buffer needs an allocator and not
; an operating system, so a freestanding program gets it.
;
; `concat` allocates a fresh `String` and copies both sides, so accumulating a
; document with `(set out (concat (& out) (& piece)))` copies everything written
; so far on every piece and is quadratic in the length of the result. A builder
; writes each piece into one buffer and allocates once, at the end (`D-145`).
;
; The buffer is a `(List u8)`. Every integer is one machine word wide whatever
; its type says, so that is a word per byte — the same shape `core:string`'s
; `from-bytes` already takes. Long pieces are copied in one runtime call
; (`sl_rt_builder_write_bytes`); short pieces skip the extra pass over the
; buffer. Growing the list still takes one `push` per byte (`D-124`).

(export Builder new write-str write-byte write-i64 write-u64 size build)

(struct Builder ((bytes (List u8|)

(extern "sl_rt_string_from_bytes" (bytes-raw (bytes &(Slice u8))) -> String)

(extern "sl_rt_string_byte" (byte-raw (text &String) (length i64) (index i64)) -> i64)

; The words are already there — `write-str` grows the buffer first — and this
; fills the last of them. The string's length is explicit because `&String`
; crosses as a pointer alone and a piece may contain NUL (`D-079`).
(extern "sl_rt_builder_write_bytes"
  (write-bytes-raw (bytes &mut (List u8)) (text &String) (length i64))
  -> unit)

; The empty `(list)` takes its element type from the field being built, which
; is the same reason `core:map` builds its bucket array in the struct literal.
(fn new () -> Builder
  (Builder :bytes (list)))

(fn size ((builder &Builder)) -> i64
  (match builder
    ((Builder :bytes bytes) (len bytes|)

(fn write-byte ((into &mut Builder) (byte u8)) -> unit
  (match into
    ((Builder :bytes bytes) (push bytes byte|)

; C may not resize a list it was handed (`D-124`), so bulk copying needs a
; zero-filled tail first. For pieces of at most one word, the second pass and
; its extra call cost more than reading the source bytes directly.
(fn write-str ((into &mut Builder) (text &String)) -> unit
  (let width (len text))
  (let mut index 0)
  (if (<= width 8)
    (while (< index width)
      (write-byte into (as u8 (byte-raw text width index)))
      (set index (+ index 1)))
    (match into
      ((Builder :bytes bytes)
        (while (< index width)
          (push bytes (as u8 0))
          (set index (+ index 1)))
        (write-bytes-raw bytes text width|)

; Emit the higher digits first, so the call stack holds at most twenty
; magnitudes instead of allocating a temporary list (`D-166`). Zero reaches
; the final write directly and produces its one digit.
(fn write-u64 ((into &mut Builder) (value u64)) -> unit
  (when (>= value 10)
    (write-u64 into (/ value 10)))
  (write-byte into (as u8 (+ 48 (as i64 (% value 10|)

; A sign and a magnitude. The magnitude of the smallest `i64` has no `i64` to
; hold it, so it is taken one below and put back as a `u64`, exactly as
; `core:string`'s `from-i64` does.
(fn write-i64 ((into &mut Builder) (value i64)) -> unit
  (if (< value 0)
    (do
      (write-byte into 45)
      (write-u64 into (+ (as u64 (- (+ value 1))) 1)))
    (write-u64 into (as u64 value|)

; The one allocation. The builder is consumed, because the bytes leave with the
; string and a buffer that has been handed over is not one to keep writing to.
(fn build ((builder Builder)) -> String
  (match builder
    ((Builder :bytes bytes)
      (let view (slice &bytes 0 (len &bytes)))
      (bytes-raw &view|)

; Private foundation for the D-167 builder; the public Builder switches later.
(struct PackedStorage ((words (List u64)) (tail u64) (used i64)))
(extern "sl_rt_panic" (storage-panic (message &String)) -> unit)
(fn storage-new () -> PackedStorage
  (PackedStorage :words (list) :tail 0 :used 0))
(fn (inline) storage-valid-parts ((count i64) (tail u64) (used i64)) -> bool
  (and (>= used 0)
       (= count (shr used 3))
       (= (shr tail (as u64 (* (bit-and used 7) 8))) 0)))
(fn storage-valid ((storage &PackedStorage)) -> bool
  (match storage
    ((PackedStorage :words words :tail tail :used used)
      (storage-valid-parts (len words) (clone tail) (clone used|)
(fn storage-check ((storage &PackedStorage)) -> unit
  (when (not (storage-valid storage))
    (storage-panic &"builder storage: invalid state")))
(fn storage-length ((used i64) (extra i64)) -> i64
  (when (or (< used 0) (< extra 0))
    (storage-panic &"builder storage: negative length"))
  (when (> used (- 9223372036854775807 extra))
    (storage-panic &"builder storage: length overflow"))
  (+ used extra))
; Extend initialized bytes with zero, preserving a valid owner at both ends.
; A full tail becomes the first new word; capacity remains the List's concern.
(fn storage-grow-zero ((storage &mut PackedStorage) (extra i64)) -> unit
  (storage-check storage)
  (match storage
    ((PackedStorage :words words :tail tail :used used)
      (let needed (storage-length (clone used) extra))
      (let complete (shr needed 3))
      (let mut count (len words))
      (when (< count complete)
        (push words (clone tail))
        (set tail 0)
        (set count (+ count 1)))
      (while (< count complete)
        (push words (as u64 0))
        (set count (+ count 1)))
      (set used needed|)
(test "packed storage starts empty and survives zero growth"
  (let mut storage (storage-new))
  (storage-grow-zero &mut storage 0)
  (storage-valid &storage))
(test "packed storage preserves a partial tail without completing a word"
  (let mut storage (PackedStorage :words (list) :tail 0x4241 :used 2))
  (storage-grow-zero &mut storage 5)
  (match &storage
    ((PackedStorage :words words :tail tail :used used)
      (and (= (len words) 0)
           (= (clone tail) 0x4241)
           (= (clone used) 7)
           (storage-valid &storage|)
(test "packed storage completes a tail into initialized words"
  (let mut storage (PackedStorage :words (list) :tail 0x4241 :used 2))
  (storage-grow-zero &mut storage 15)
  (match &storage
    ((PackedStorage :words words :tail tail :used used)
      (and (= (len words) 2)
           (= (get words 0) (as u64 0x4241))
           (= (get words 1) (as u64 0))
           (= (clone tail) 0)
           (= (clone used) 17)
           (storage-valid &storage|)
(test "packed storage crosses repeated capacity boundaries"
  (let mut storage (storage-new))
  (let mut length 0)
  (let mut valid true)
  (while (< length 1100)
    (storage-grow-zero &mut storage 1)
    (set length (+ length 1))
    (set valid (and valid (storage-valid &storage))))
  valid)
(test "packed storage clone keeps an independent owner"
  (let mut original
    (PackedStorage :words (list (as u64 0x4847464544434241)) :tail 0x4a49 :used 10))
  (let mut copied (clone original))
  (storage-grow-zero &mut copied 70)
  (storage-grow-zero &mut original 1)
  (and (storage-valid &original)
    (storage-valid &copied)
    (match &original
      ((PackedStorage :words words :tail tail :used used)
        (and (= (len words) 1) (= (clone tail) 0x4a49) (= (clone used) 11))))
    (match &copied
      ((PackedStorage :words words :tail tail :used used)
        (and (= (len words) 10)
             (= (get words 1) (as u64 0x4a49))
             (= (clone used) 80|)
(test "packed length planning reaches the signed limit without rounding overflow"
  (and (= (storage-length 0 9223372036854775807) 9223372036854775807)
       (= (storage-length 9223372036854775800 7) 9223372036854775807)
       (= (shr (storage-length 9223372036854775807 0) 3) 1152921504606846975)))
(test "packed storage rejects invalid metadata before growth"
  (and (not (storage-valid &(PackedStorage :words (list) :tail 0 :used -1)))
       (not (storage-valid &(PackedStorage :words (list) :tail 0 :used 8)))
       (not (storage-valid &(PackedStorage :words (list) :tail 256 :used 1)))
       (not (storage-valid &(PackedStorage :words (list) :tail 1 :used 0|)
(test "packed growth preserves every starting tail offset"
  (let mut offset 0)
  (let mut valid true)
  (while (< offset 8)
    (let tail (if (= offset 0) (as u64 0) (- (shl (as u64 1) (as u64 (* offset 8))) 1)))
    (let mut extra 0)
    (while (< extra 20)
      (let mut storage
        (PackedStorage :words (list (as u64 0x8877665544332211))
                       :tail tail
                       :used (+ 8 offset)))
      (storage-grow-zero &mut storage extra)
      (set valid (and valid (storage-valid &storage)))
      (match &storage
        ((PackedStorage :words words :tail remaining :used used)
          (set valid
            (and valid
                 (= (get words 0) (as u64 0x8877665544332211))
                 (= (clone used) (+ 8 (+ offset extra)))))
          (if (< (+ offset extra) 8)
            (set valid (and valid (= (clone remaining) tail)))
            (do
              (set valid (and valid (= (get words 1) tail) (= (clone remaining) 0)))
              (let mut at 2)
              (while (< at (len words))
                (set valid (and valid (= (get words at) (as u64 0))))
                (set at (+ at 1)))))))
      (set extra (+ extra 1)))
    (set offset (+ offset 1)))
  valid)

(extern "sl_rt_builder_pack_words"
  (storage-pack (words &mut (List u64))
                (tail u64)
                (used i64)
                (text &String)
                (length i64))
  -> u64)

; Only checked operations call this after reserving logical length.
(fn storage-byte-unchecked ((storage &mut PackedStorage) (byte u8)) -> unit
  (match storage
    ((PackedStorage :words words :tail tail :used used)
      (let offset (bit-and (clone used) 7))
      (let combined (bit-or (clone tail) (shl (as u64 byte) (as u64 (* offset 8)))))
      (if (= offset 7)
        (do
          (push words combined)
          (set tail 0))
        (set tail combined))
      (set used (+ (clone used) 1|)
(fn storage-write-byte ((storage &mut PackedStorage) (byte u8)) -> unit
  (storage-check storage)
  (match storage
    ((PackedStorage :words _ :tail _ :used used) (storage-length (clone used) 1)))
  (storage-byte-unchecked storage byte))
; Keep checked scalar metadata live through growth, so even one-byte pieces
; avoid repeated owner traversals. C sees sized words only during its borrow.
(fn storage-write-str ((storage &mut PackedStorage) (text &String)) -> unit
  (match storage
    ((PackedStorage :words words :tail tail :used used)
      (let old-used (clone used))
      (let old-tail (clone tail))
      (let mut count (len words))
      (when (not (storage-valid-parts count old-tail old-used))
        (storage-panic &"builder storage: invalid state"))
      (let width (len text))
      (when (< width 0)
        (storage-panic &"builder storage: negative length"))
      (when (> old-used (- 9223372036854775807 width))
        (storage-panic &"builder storage: length overflow"))
      (when (> width 0)
        (let needed (+ old-used width))
        (let complete (shr needed 3))
        (while (< count complete)
          (push words (as u64 0))
          (set count (+ count 1)))
        (set tail (storage-pack words old-tail old-used text width))
        (set used needed|)

; The existing quotient-first algorithm emits at most twenty decimal digits.
(fn storage-digits ((storage &mut PackedStorage) (value u64)) -> unit
  (when (>= value 10)
    (storage-digits storage (/ value 10)))
  (storage-byte-unchecked storage (as u8 (+ 48 (as i64 (% value 10|)
(fn storage-integer-room ((used i64) (value u64) (sign i64)) -> unit
  (when (> used 9223372036854775787)
    (let mut remaining value)
    (let mut width (+ sign 1))
    (while (>= remaining 10)
      (set remaining (/ remaining 10))
      (set width (+ width 1)))
    (storage-length used width)))
(fn storage-write-u64 ((storage &mut PackedStorage) (value u64)) -> unit
  (storage-check storage)
  (match storage
    ((PackedStorage :words _ :tail _ :used used)
      (storage-integer-room (clone used) value 0)))
  (storage-digits storage value))
(fn storage-write-i64 ((storage &mut PackedStorage) (value i64)) -> unit
  (storage-check storage)
  (let magnitude (if (< value 0) (+ (as u64 (- (+ value 1))) 1) (as u64 value)))
  (match storage
    ((PackedStorage :words _ :tail _ :used used)
      (storage-integer-room (clone used) magnitude (if (< value 0) 1 0))))
  (when (< value 0)
    (storage-byte-unchecked storage 45))
  (storage-digits storage magnitude))

; Compare private storage without exporting a reader or finalization operation.
(fn storage-test-equal ((storage &PackedStorage) (text &String)) -> bool
  (match storage
    ((PackedStorage :words words :tail tail :used used)
      (let mut valid (and (storage-valid storage) (= (clone used) (len text))))
      (let mut index 0)
      (while (< index (clone used))
        (let word
          (if (< (shr index 3) (len words)) (get words (shr index 3)) (clone tail)))
        (set valid
          (and valid
            (= (as i64 (bit-and (shr word (as u64 (* (bit-and index 7) 8))) 255))
               (byte-raw text (len text) index))))
        (set index (+ index 1)))
      valid)))
(test "packed append bytes and pieces across all tail offsets"
  (let text "\0\x80\xfféabcdef0123456789")
  (let mut valid true)
  (let mut offset 0)
  (while (< offset 8)
    (let mut width 0)
    (while (<= width (len &text))
      (let mut storage (storage-new))
      (let mut reference (new))
      (let mut prefix 0)
      (while (< prefix offset)
        (storage-write-byte &mut storage 255)
        (write-byte &mut reference 255)
        (set prefix (+ prefix 1)))
      (let mut source (new))
      (let mut source-index 0)
      (while (< source-index width)
        (write-byte &mut source (as u8 (byte-raw &text (len &text) source-index)))
        (set source-index (+ source-index 1)))
      (let piece (build source))
      (storage-write-str &mut storage &piece)
      (write-str &mut reference &piece)
      (storage-write-str &mut storage &"")
      (set valid (and valid (storage-test-equal &storage &(build reference))))
      (set width (+ width 1)))
    (set offset (+ offset 1)))
  valid)
(test "packed append keeps integer extremes and zero"
  (let mut storage (storage-new))
  (storage-write-i64 &mut storage -9223372036854775808)
  (storage-write-byte &mut storage 32)
  (storage-write-u64 &mut storage 18446744073709551615)
  (storage-write-byte &mut storage 32)
  (storage-write-i64 &mut storage 9223372036854775807)
  (storage-write-byte &mut storage 32)
  (storage-write-u64 &mut storage 0)
  (storage-test-equal &storage
    &"-9223372036854775808 18446744073709551615 9223372036854775807 0"))

(test "packed append preserves every byte and repeated mixed growth"
  (let mut storage (storage-new))
  (let mut reference (new))
  (let piece "\0\x80\xffé0123456789")
  (let mut i 0)
  (while (< i 1024)
    (let byte (as u8 (bit-and i 255)))
    (storage-write-byte &mut storage byte)
    (write-byte &mut reference byte)
    (storage-write-str &mut storage &piece)
    (write-str &mut reference &piece)
    (storage-write-i64 &mut storage (- i 512))
    (write-i64 &mut reference (- i 512))
    (set i (+ i 1)))
  (and (storage-test-equal &storage &(build reference))
       (storage-test-equal &(storage-new) &"")
       (= (len &piece) 15)))
(test "packed append clones an independent tail and complete words"
  (let mut original (storage-new))
  (storage-write-str &mut original &"abcdefgh\0\xff")
  (let mut copied (clone original))
  (storage-write-str &mut original &"é")
  (storage-write-u64 &mut copied 18446744073709551615)
  (and (storage-test-equal &original &"abcdefgh\0\xffé")
       (storage-test-equal &copied &"abcdefgh\0\xff18446744073709551615")))
(test "packed integer preflight accepts exact available room"
  (storage-integer-room 9223372036854775806 0 0)
  (storage-integer-room 9223372036854775805 1 1)
  (storage-integer-room 9223372036854775787 18446744073709551615 0)
  (storage-integer-room 9223372036854775787 9223372036854775808 1)
  true)
