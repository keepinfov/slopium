; An optional value, and the combinators that make refusing traits honest.
;
; `D-088` refused traits for 1.0 and named this module as the cost: without a
; function type there is nothing for `map` to take, so `Option` was an enum and
; no more. `D-092` made a function a value and `D-095` let a generic function
; take a generic type, so the cost is paid here.
;
; A combinator takes its `Option` by ownership because it produces a new one out
; of it; a question about one takes a borrow and leaves it where it was. Until
; `D-099` there was no second kind — `match` did not work through a borrow, so
; asking which variant a value is consumed it, and `is-some` could not be
; written at all.

(export Option is-some is-none map and-then unwrap-or or-else)

(enum Option (T)
  None
  (Some ((value T|)

; Asking without taking. The `_` matters: a payload bound through a borrow is a
; `(& T)` and binding one here would say this function cares what is inside,
; which it does not.
(fn is-some (T) ((value &(Option T))) -> bool
  (match value
    ((Option:Some _) true)
    ((Option:None) false)))

(fn is-none (T) ((value &(Option T))) -> bool
  (match value
    ((Option:Some _) false)
    ((Option:None) true)))

(fn map (T U) ((value (Option T)) (f (Fn (T) U))) -> (Option U)
  (match value
    ((Option:Some inner) (Option:Some (f inner)))
    ((Option:None) (Option:None|)

; `f` returns an `Option` of its own, so nesting does not accumulate.
(fn and-then (T U) ((value (Option T)) (f (Fn (T) (Option U)))) -> (Option U)
  (match value
    ((Option:Some inner) (f inner))
    ((Option:None) (Option:None|)

; The fallback is evaluated by the caller either way. `or-else` is the lazy
; form, and the pair is deliberate rather than an oversight. Until `D-102` it
; was also the weaker of the two: a `(Fn () T)` could defer work but could not
; carry anything computed nearby, which is the one place in this library where
; the absence of closures was felt as an absence. A `lambda` closes it without
; changing either signature.
(fn unwrap-or (T) ((value (Option T)) (fallback T)) -> T
  (match value
    ((Option:Some inner) inner)
    ((Option:None) fallback)))

(fn or-else (T) ((value (Option T)) (f (Fn () (Option T)))) -> (Option T)
  (match value
    ((Option:Some inner) (Option:Some inner))
    ((Option:None) (f|)
