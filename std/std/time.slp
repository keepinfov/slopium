; The clock, which belongs to the operating system and not to the language.
;
; Two of them, because they answer different questions. `monotonic` only ever
; goes forward and is what a duration is measured with. `realtime` is what a
; timestamp is written from, and it can go backwards when something corrects
; it — so measuring an interval with it is a bug that shows up once a year.
;
; Nanoseconds in an `i64`, and not an `f64`: a wall-clock reading is about
; 1.7 * 10^18 nanoseconds and an `f64` runs out of exact integers at 2^53, so
; a float would have started rounding the clock away in 1970 plus a few months.
; An `i64` holds a wall-clock reading until the year 2262.
;
; `struct timespec` is not in the `extern` vocabulary (`D-065`), which is why
; the runtime is where a reading is flattened into one number (`D-147`).

(take core:result Result Ok Err)

(export Error monotonic realtime)

(struct Error ((code i64)))

(extern "sl_rt_time_monotonic" (monotonic-raw) -> i64)

(extern "sl_rt_time_realtime" (realtime-raw) -> i64)

(extern "sl_rt_last_error" (last-error) -> i64)

; Nanoseconds since an unspecified point that does not move. Two readings can
; be subtracted; one on its own means nothing.
(fn monotonic () -> (Result i64 Error)
  (let value (monotonic-raw))
  (let code (last-error))
  (if (= code 0) (Result:Ok value) (Result:Err (Error :code code))))

; Nanoseconds since 1970-01-01T00:00:00Z, which is what a timestamp is.
(fn realtime () -> (Result i64 Error)
  (let value (realtime-raw))
  (let code (last-error))
  (if (= code 0) (Result:Ok value) (Result:Err (Error :code code))))
