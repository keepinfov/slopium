; Standard input and output.
;
; There are no traits and none are planned (`D-088`), so one name cannot print
; every printable type and the widths are separate functions. What changed at
; v0.5.3 is that only the two byte-writing entry points are still C: a number
; reaches them through `core:string:from-i64`, and `read-i64` is `read-line`
; and `to-i64` (`D-086`, `D-087`). There is no `print-i32` and there will not
; be one: since v0.6.1 an `i32` widens at the call, as `(print-i64 (as i64
; value))` (`D-090`). `D-107` made that eight types rather than two and did not
; change the rule — the only pair here is signed and unsigned, because they are
; the two that disagree about what a full machine word means.

(take core:option Option)
(take core:string from-i64 from-u64 to-i64 trim)

(export print println print-i64 println-i64 print-u64 println-u64 print-bool
  println-bool read-line read-i64)

; A `(& String)` crosses the boundary as a pointer with no length, and a
; Slopium string may contain a NUL byte, so the length travels beside it
; (`D-079`).
(extern "sl_rt_print_bytes" (write-bytes (bytes (& String)) (length i64)) -> unit)

(extern "sl_rt_println_bytes"
  (write-line-bytes (bytes (& String)) (length i64)) -> unit)

(extern "sl_rt_read_line" (read-line-raw) -> String)

; Zero is a line, a positive value is an `errno`, and `-1` is end of input
; (`D-085`).
(extern "sl_rt_last_error" (last-error) -> i64)

(fn print ((text (& String))) -> unit
  (write-bytes text (len text)))

(fn println ((text (& String))) -> unit
  (write-line-bytes text (len text)))

(fn print-i64 ((value i64)) -> unit
  (print (& (from-i64 value))))

(fn println-i64 ((value i64)) -> unit
  (println (& (from-i64 value))))

(fn print-u64 ((value u64)) -> unit
  (print (& (from-u64 value))))

(fn println-u64 ((value u64)) -> unit
  (println (& (from-u64 value))))

(fn print-bool ((flag bool)) -> unit
  (print-i64 (if flag 1 0)))

(fn println-bool ((flag bool)) -> unit
  (println-i64 (if flag 1 0)))

; `None` at end of input. An empty line is `(Option:Some "")`, which is why the
; status slot and not the length is what says which happened.
(fn read-line () -> (Option String)
  (let line (read-line-raw))
  (if (= (last-error) 0)
    (Option:Some line)
    (Option:None)))

; A line read from a terminal usually has spaces around it, and a line that is
; only spaces is not a number, so the trim happens here and not in `to-i64`.
(fn read-i64 () -> (Option i64)
  (match (read-line)
    ((Option:Some line)
      (do
        (let text (trim (& line)))
        (to-i64 (& text))))
    ((Option:None) (Option:None))))
