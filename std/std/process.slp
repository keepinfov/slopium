; The process this program is: its arguments, its environment, and how it ends.
;
; Nothing here aborts. An index past the last argument and a variable that is
; not set are both `None`, because both are things a program can be asked to
; handle rather than things it got wrong (`D-087`).
;
; An argument is one the program was given. `args-len` does not count the name
; the program was invoked under and `arg` does not index it, so `(arg 0)` is
; the first argument rather than the program: one less than C's `argc`, and one
; place along from its `argv`. That is what a program asking for its arguments
; wants, and it is what every caller below already depends on.

(take core:option Option)
(take core:result Result Ok Err)
(take core:builder new write-str write-byte build)

(export args-len arg args env exit Error Child spawn capture wait read-output
  close-output pid-of)

; Every call that can fail sets the runtime's status slot and every function
; below reads it in the form immediately after the call (`D-085`). The code in
; an `Error` is an `errno`.
(struct Error ((code i64)))

(extern "sl_rt_args_len" (args-len) -> i64)

(extern "sl_rt_arg" (arg-raw (index i64)) -> String)

; The runtime refuses a name with an embedded NUL rather than looking up the
; prefix `getenv` would stop at, and it needs the length to see one (`D-079`).
(extern "sl_rt_env" (env-raw (name &String) (length i64)) -> String)

; Zero is success, and anything else is the status the process exits with
; (`D-085` for the slot this does not use: nothing comes back).
(extern "sl_rt_exit" (exit (status i64)) -> unit)

(extern "sl_rt_last_error" (last-error) -> i64)

(fn arg ((index i64)) -> (Option String)
  (if (and (>= index 0) (< index (args-len)))
    (Option:Some (arg-raw index))
    (Option:None)))

; The list starts with a placeholder and loses it again, because an empty
; `(list)` has no element type to infer and a process may have no arguments.
(fn args () -> (List String)
  (let count (args-len))
  (let mut collected (list ""))
  (let discarded (remove &mut collected 0))
  (let mut index 0)
  (while (< index count)
    (push &mut collected (arg-raw index))
    (set index (+ index 1)))
  collected)

; A name containing a NUL byte cannot name a variable, so it is `None` for the
; same reason a name that is not set is.
(fn env ((name &String)) -> (Option String)
  (let value (env-raw name (len name)))
  (if (= (last-error) 0) (Option:Some value) (Option:None)))

; Starting a child, waiting for it, and reading what it wrote (`D-148`).
;
; A `Child` carries a pid and a descriptor, and neither owns anything: a struct
; wrapping an `i64` has no drop glue, so nothing runs when it dies (`D-084`).
; That is why the descriptor is closed by a `defer` and why this is expressible
; now and was not before `D-133` — `close-output` is written beside the call
; that opened it and runs however the scope ends.
;
; A `Child` that inherited the parent's output carries `-1`, and closing that
; is a no-op, so the same `defer` is written either way.
(struct Child ((pid i64) (output i64)))

; Zero and one rather than a `bool`, because what crosses the boundary is a
; scalar and the two spellings are separate names here (`D-129`).
(extern "sl_rt_process_spawn"
  (spawn-raw (program &String)
             (program-length i64)
             (arguments &String)
             (arguments-length i64)
             (capture i64)
             (output &mut i64))
  -> i64)

(extern "sl_rt_process_wait" (wait-raw (pid i64)) -> i64)

(extern "sl_rt_process_read" (read-raw (descriptor i64)) -> String)

(extern "sl_rt_process_close" (close-raw (descriptor i64)) -> i64)

; The arguments as one buffer of NUL-separated pieces, which is how a list of
; strings crosses a boundary whose vocabulary has no row for one.
(fn joined ((arguments &(List String))) -> String
  (let mut out (new))
  (let count (len arguments))
  (let mut index 0)
  (while (< index count)
    (when (> index 0)
      (write-byte &mut out (as u8 0)))
    (write-str &mut out (get-ref arguments index))
    (set index (+ index 1)))
  (build out))

(fn started ((program &String) (arguments &(List String)) (capture i64))
  -> (Result Child Error)
  (let blob (joined arguments))
  (let mut output -1)
  (let pid (spawn-raw program (len program) &blob (len &blob) capture &mut output))
  (let code (last-error))
  (if (= code 0)
    (Result:Ok (Child :pid pid :output output))
    (Result:Err (Error :code code|)

; The child writes where this program writes. What a build tool wants, and what
; leaves nothing to close.
(fn spawn ((program &String) (arguments &(List String))) -> (Result Child Error)
  (started program arguments 0))

; The child's standard output is a pipe this program holds the read end of.
; Read it before waiting: a child writing more than a pipe holds blocks until
; somebody drains it.
(fn capture ((program &String) (arguments &(List String))) -> (Result Child Error)
  (started program arguments 1))

(fn pid-of ((child &Child)) -> i64
  (match child
    ((Child :pid pid :output _) (clone pid|)

; The exit status, or `128` plus the signal for a child something killed, which
; is what a shell reports. A program that could not be started at all is `127`,
; delivered by the child rather than by this call, because a failed `exec`
; after a successful `fork` is already a running process.
(fn wait ((child &Child)) -> (Result i64 Error)
  (let status (wait-raw (pid-of child)))
  (let code (last-error))
  (if (= code 0) (Result:Ok status) (Result:Err (Error :code code|)

(fn read-output ((child &Child)) -> (Result String Error)
  (match child
    ((Child :pid _ :output output)
      (let text (read-raw (clone output)))
      (let code (last-error))
      (if (= code 0) (Result:Ok text) (Result:Err (Error :code code|)

; Written as a `defer` beside the call that opened the descriptor. It answers
; nothing: a close that fails has already lost the descriptor, and there is
; nothing a caller could do about it that it could not do about a leak.
(fn close-output ((child &mut Child)) -> unit
  (match child
    ((Child :pid _ :output output)
      (let discarded (close-raw (clone output)))
      (set output -1|)
