; Naive recursive Fibonacci. Measures function-call overhead and recursion:
; nothing is allocated, nothing is shared, and every call costs what the
; calling convention and the prologue cost.

(take std:io println)
(take std:string concat from-i64)

(const depth 32)

(fn fib ((n i64)) -> i64
  (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))

(fn main () -> i32
  (let text (concat &"fib(32) = " &(from-i64 (fib depth))))
  (println &text)
  0)
