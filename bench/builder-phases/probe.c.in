#define _POSIX_C_SOURCE 200809L
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define COUNT @COUNT@
#define MODE @MODE@

static int64_t now(void) {
    struct timespec value;
    if (clock_gettime(CLOCK_MONOTONIC, &value)) abort();
    return (int64_t)value.tv_sec * 1000000000 + value.tv_nsec;
}

static void append(char **buffer, size_t *length, size_t *capacity,
                   const char *piece, size_t width) {
    if (*length + width > *capacity) {
        size_t next = *capacity ? *capacity : 8;
        while (next < *length + width) next *= 2;
        char *grown = realloc(*buffer, next);
        if (!grown) abort();
        *buffer = grown;
        *capacity = next;
    }
    memcpy(*buffer + *length, piece, width);
    *length += width;
}

int main(void) {
    const char *piece = "@PIECE@";
    int64_t start = now();
    char *buffer = NULL;
    size_t length = 0, capacity = 0;
    for (int64_t i = 0; i < COUNT; i++) {
        char digits[32];
        if (MODE == 0) {
            append(&buffer, &length, &capacity, "item ", 5);
            int width = snprintf(digits, sizeof digits, "%lld", (long long)i);
            append(&buffer, &length, &capacity, digits, (size_t)width);
            append(&buffer, &length, &capacity, "\n", 1);
        } else if (MODE == 1) {
            append(&buffer, &length, &capacity, piece, strlen(piece));
        } else if (MODE == 3) {
            int width = snprintf(digits, sizeof digits, "%llu",
                                 (unsigned long long)(UINT64_MAX - (uint64_t)i));
            append(&buffer, &length, &capacity, digits, (size_t)width);
        } else {
            int width = snprintf(digits, sizeof digits, "%lld", (long long)i);
            append(&buffer, &length, &capacity, digits, (size_t)width);
        }
    }
    int64_t appended = now();
    /* Match Slopium's owned final String with one linear final copy. */
    char *text = malloc(length + 1);
    if (!text) abort();
    memcpy(text, buffer, length);
    text[length] = '\0';
    free(buffer);
    int64_t finalized = now();
    int64_t sum = 0;
    for (size_t j = 0; j < length; j++) sum += (unsigned char)text[j];
    int64_t checked = now();
    int64_t clock_end = now();
    printf("%zu\n%lld\n%lld\n%lld\n%lld\n%lld\n", length,
           (long long)sum, (long long)(appended - start),
           (long long)(finalized - appended), (long long)(checked - finalized),
           (long long)(clock_end - checked));
    free(text);
    return 0;
}
