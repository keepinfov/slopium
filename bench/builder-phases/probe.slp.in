; Diagnostic copy of the control workload; the original kernel is unchanged.
(take std:io println-i64)
(take std:builder new write-str write-i64 write-byte build)
(take std:string byte-at)
(take std:time monotonic)
(take std:result Result)
(take std:panic panic)

(const count @COUNT@)
(const mode @MODE@)

(fn now () -> i64
  (match (monotonic)
    ((Result:Ok value) value)
    ((Result:Err _) (do (panic &"monotonic clock failed") 0))))

(fn main () -> i32
  (let piece "@PIECE@")
  (let start (now))
  (let mut out (new))
  (let mut i 0)
  (while (< i count)
    (if (= mode 0)
      (do
        (write-str &mut out &"item ")
        (write-i64 &mut out i)
        (write-byte &mut out 10))
      (if (= mode 1)
        (write-str &mut out &piece)
        (write-i64 &mut out i)))
    (set i (+ i 1)))
  (let appended (now))
  (let text (build out))
  (let finalized (now))
  (let width (len &text))
  (let mut sum 0)
  (let mut j 0)
  (while (< j width)
    (set sum (+ sum (byte-at &text j)))
    (set j (+ j 1)))
  (let checked (now))
  (let clock-end (now))
  ; The harness separates the two deterministic lines from four timing lines.
  (println-i64 width)
  (println-i64 sum)
  (println-i64 (- appended start))
  (println-i64 (- finalized appended))
  (println-i64 (- checked finalized))
  (println-i64 (- clock-end checked))
  0)
