(take packed Buffer new write-byte write-str write-u64 write-i64 size read-at build)
(take std:string concat equals from-u64 byte-at)
(take std:panic assert)

(fn partial ((prefix i64) (width i64)) -> unit
  (let mut out (new))
  (let mut expected "")
  (let mut i 0)
  (while (< i prefix)
    (write-byte &mut out 62)
    (set expected (concat &expected &">"))
    (set i (+ i 1)))
  (set i 0)
  (while (< i width)
    (write-str &mut out &"a\0\x80\xffé0123456789")
    (set expected (concat &expected &"a\0\x80\xffé0123456789"))
    (set i (+ i 1)))
  (let mut at 0)
  (while (< at (len &expected))
    (assert (= (read-at &out at) (byte-at &expected at)) &"packed indexed read")
    (set at (+ at 1)))
  (let mut copied (clone out))
  (write-str &mut out &"!")
  (write-str &mut copied &"?")
  (assert (= (size &out) (+ (len &expected) 1)) &"logical byte size")
  (assert (equals &(build out) &(concat &expected &"!")) &"original bytes")
  (assert (equals &(build copied) &(concat &expected &"?")) &"independent clone"))

(fn abandoned () -> unit
  (let mut out (new))
  (write-str &mut out &"an abandoned buffer still owns all of its words"))

(fn main () -> i32
  (abandoned)
  (assert (equals &(build (new)) &"") &"empty")
  (let mut offset 0)
  (while (< offset 8)
    (partial offset 0)
    (partial offset 1)
    (partial offset 100)
    (set offset (+ offset 1)))
  (let mut out (new))
  (write-i64 &mut out -9223372036854775808)
  (write-byte &mut out 32)
  (write-i64 &mut out 9223372036854775807)
  (write-byte &mut out 32)
  (write-u64 &mut out 18446744073709551615)
  (write-byte &mut out 32)
  (write-u64 &mut out 0)
  (assert (equals &(build out)
    &"-9223372036854775808 9223372036854775807 18446744073709551615 0") &"integer boundaries")
  (let mut power (as u64 1))
  (let mut exponent 0)
  (while (< exponent 20)
    (let mut digits (new))
    (write-u64 &mut digits power)
    (assert (equals &(build digits) &(from-u64 power)) &"decimal power")
    (set exponent (+ exponent 1))
    (when (< exponent 20) (set power (* power 10))))
  0)
