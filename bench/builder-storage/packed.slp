; Research only. Full words live in an ordinary List; a partial word stays in
; the owner, so one-byte writes do not read/replace a list element each time.
(take core:panic panic)
(export Buffer new write-byte write-str write-u64 write-i64 size storage-bytes read-at build)
(struct Buffer ((words (List u64)) (tail u64) (used i64)))
(extern "study_pack"
  (pack (words &mut (List u64)) (tail u64) (used i64)
        (text &String) (length i64)) -> u64)
(extern "study_finish"
  (finish (words &(Slice u64)) (tail u64) (used i64)) -> String)
(fn new () -> Buffer
  (Buffer :words (list) :tail 0 :used 0))
(fn size ((out &Buffer)) -> i64
  (match out ((Buffer :words _ :tail _ :used used) (clone used))))
(fn storage-bytes ((out &Buffer)) -> i64
  (match out ((Buffer :words words :tail _ :used _) (+ (* (len words) 8) 8))))
(fn read-at ((out &Buffer) (index i64)) -> i64
  (match out
    ((Buffer :words words :tail tail :used used)
      (when (or (< index 0) (>= index (clone used)))
        (panic &"storage study: read bounds"))
      (let word (if (< (shr index 3) (len words)) (get words (shr index 3)) (clone tail)))
      (as i64 (bit-and (shr word (as u64 (* (bit-and index 7) 8))) 255)))))
(fn write-byte ((out &mut Buffer) (byte u8)) -> unit
  (match out
    ((Buffer :words words :tail tail :used used)
      (let offset (bit-and (clone used) 7))
      (let combined (bit-or (clone tail) (shl (as u64 byte) (as u64 (* offset 8)))))
      (if (= offset 7)
        (do (push words combined) (set tail 0))
        (set tail combined))
      (set used (+ (clone used) 1)))))
(fn write-str ((out &mut Buffer) (text &String)) -> unit
  (let width (len text))
  (when (> width 0)
    (match out
      ((Buffer :words words :tail tail :used used)
        (let needed (+ (clone used) width))
        (let complete (shr needed 3))
        (let mut count (len words))
        (while (< count complete)
          (push words (as u64 0))
          (set count (+ count 1)))
        (set tail (pack words (clone tail) (clone used) text width))
        (set used needed)))))
(fn write-u64 ((out &mut Buffer) (value u64)) -> unit
  (when (>= value 10) (write-u64 out (/ value 10)))
  (write-byte out (as u8 (+ 48 (as i64 (% value 10))))))
(fn write-i64 ((out &mut Buffer) (value i64)) -> unit
  (if (< value 0)
    (do (write-byte out 45) (write-u64 out (+ (as u64 (- (+ value 1))) 1)))
    (write-u64 out (as u64 value))))
(fn build ((out Buffer)) -> String
  (match out
    ((Buffer :words words :tail tail :used used)
      (let view (slice &words 0 (len &words)))
      (finish &view tail used))))
