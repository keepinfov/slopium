; Study diagnostic: builder read and owned finalization are distinct intervals.
@IMPORT@
(take std:io println-i64)
(take std:string byte-at)
(take std:time monotonic)
(take std:result Result)
(take std:panic panic)
@READ@
(const count @COUNT@)
(const mode @MODE@)
(fn now () -> i64
  (match (monotonic)
    ((Result:Ok value) value)
    ((Result:Err _) (do (panic &"monotonic clock failed") 0))))
(fn main () -> i32
  (let piece "@PIECE@")
  (let start (now))
  (let mut out (new))
  (let mut i 0)
  (while (< i count)
    (if (= mode 0)
      (do (write-str &mut out &"item ") (write-i64 &mut out i) (write-byte &mut out 10))
      (if (= mode 1)
        (write-str &mut out &piece)
        (if (= mode 3)
          (write-u64 &mut out (- (as u64 18446744073709551615) (as u64 i)))
          (write-i64 &mut out i))))
    (set i (+ i 1)))
  (let appended (now))
  (let width (size &out))
  (let mut read-sum 0)
  (let mut at 0)
  (while (< at width)
    (set read-sum (+ read-sum (read-at &out at)))
    (set at (+ at 1)))
  (let read (now))
  (let text (build out))
  (let finalized (now))
  (let mut sum 0)
  (set at 0)
  (while (< at width)
    (set sum (+ sum (byte-at &text at)))
    (set at (+ at 1)))
  (let checked (now))
  (let clock-end (now))
  (println-i64 width)
  (println-i64 sum)
  (println-i64 read-sum)
  (println-i64 (- appended start))
  (println-i64 (- read appended))
  (println-i64 (- finalized read))
  (println-i64 (- checked finalized))
  (println-i64 (- clock-end checked))
  0)
