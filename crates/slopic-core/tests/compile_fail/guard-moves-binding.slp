; A guard runs before its arm is taken (`D-121`), so a move inside one would
; consume a value the arms after it still match against.
(struct Tag ((name String) (weight i64)))

(fn length ((text String)) -> i64
  (len (& text)))

(fn pick ((tag Tag)) -> i64
  (match tag
    ((Tag :name name :weight _) when (> (length name) 3) 1)
    ((Tag :name _ :weight _) 0)))

(fn main () -> i32
  (let tag (Tag :name "ann" :weight 1))
  (as i32 (- (pick tag) 0)))
