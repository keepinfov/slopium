; The shape `core:map:new` has, and the one ergonomic hole `D-104` leaves open:
; the value type appears only in the result, and a `let` carries no type, so
; nothing at the call says what the empty container holds. An empty one has to
; be written where a type is written down — as the result of a function.
(struct Table (K V) ((keys (List K)) (values (List V))))

(fn empty-table (K V) ((keys (List K))) -> (Table K V)
  (Table :keys keys :values (list)))

(fn main () -> i32
  (let names (list "ann"))
  (let table (empty-table names))
  0)
