; The shape `core:map:new` has: the value type appears only in the result, so
; nothing in the call says what the empty container holds. Since v0.9.1 there
; is somewhere to say it — `(let table (empty-table names) : (Table String
; i64))` — and the diagnostic names that fix rather than only the hole
; (`D-121`). Written without it, this is still the error it always was.
(struct Table (K V) ((keys (List K)) (values (List V))))

(fn empty-table (K V) ((keys (List K))) -> (Table K V)
  (Table :keys keys :values (list)))

(fn main () -> i32
  (let names (list "ann"))
  (let table (empty-table names))
  0)
