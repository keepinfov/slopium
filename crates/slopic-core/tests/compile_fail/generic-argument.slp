(enum Pick (T)
  Nothing
  (Just ((value T))))

(struct Pair (T) ((left T) (right T)))

(fn unwrap-pick (T) ((value (Pick T)) (fallback T)) -> T
  (match value
    ((Pick:Just inner) inner)
    ((Pick:Nothing) fallback)))

(fn main () -> i32
  (do
    (let pair (Pair :left 1 :right 2))
    (unwrap-pick pair 0)
    0))
