(take math:lib answer)
(take geo:lib perimeter)

(fn main () -> i32
  (println (answer))
  (println (perimeter))
  (println (+ (math:base:numbers:forty) (geo:base:numbers:forty)))
  0)

(test "both branches of a diamond reach the shared dependency"
  (= (+ (answer) (perimeter)) 122))

(test "each branch namespaces the shared dependency separately"
  (= (math:base:numbers:forty) (geo:base:numbers:forty)))
