(take mathlib:lib answer)
(take geometry:lib perimeter)

(fn main () -> i32
  (println (answer))
  (println (perimeter))
  (println (foundation:numbers:forty))
  0)

(test "both branches of a diamond reach the shared dependency"
  (= (+ (answer) (perimeter)) 122))

(test "the shared dependency is resolved once, under its own package name"
  (= (perimeter) (+ (foundation:numbers:forty) (foundation:numbers:forty))))
