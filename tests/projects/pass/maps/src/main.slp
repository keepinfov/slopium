; Maps and sets. A `Map` is a library type written in Slopium over two function
; values — a hash and an equality — which is the answer `D-062` asked for and
; assumed needed traits (`D-104`).
;
; Everything that writes consumes the map and gives it back, because the
; language assigns to a name and to nothing else. `(set scores (map-insert
; scores key value))` is the whole convention.

(take std:io println println-i64)
(take std:string hash equals from-i64 concat)
(take std:map Map map-new map-insert map-lookup map-contains map-delete
  map-size map-fold)
(take std:set Set set-of set-add set-holds set-discard set-count set-each)
(take std:option Option unwrap-or)

; An empty container needs its type from somewhere, and a `let` carries none.
; A function that says what it returns is where the type is written down, the
; same as `(fn nothing () -> (Option String) (Option:None))`.
(fn empty-scores () -> (Map String i64)
  (map-new hash equals))

(fn empty-notes () -> (Map i64 String)
  (map-new hash-i64 same-i64))

(fn empty-names () -> (Set String)
  (set-of hash equals))

; A key type brings its own two functions, and nothing about `i64` had to be
; anticipated by the library for this to work.
(fn hash-i64 ((key (& i64))) -> i64
  (clone key))

(fn same-i64 ((a (& i64)) (b (& i64))) -> bool
  (= (clone a) (clone b)))

; A hash is free to be negative — nothing in the interface says otherwise — and
; the smallest `i64` is where a hash that took an absolute value would trap.
(fn below-zero ((key (& i64))) -> i64
  (let value (clone key))
  (if (> value 0)
    (- 0 value)
    value))

(fn empty-marks () -> (Map i64 i64)
  (map-new below-zero same-i64))

(fn key-for ((index i64)) -> String
  (let prefix "key-")
  (let digits (from-i64 index))
  (concat (& prefix) (& digits)))

(fn add-up ((carried i64) (key (& String)) (value (& i64))) -> i64
  (+ carried (clone value)))

(fn longest ((carried i64) (key (& String))) -> i64
  (if (> (len key) carried)
    (len key)
    carried))

; Forty keys into a table that starts with four buckets: three rehashes, and
; every key has to still be findable in the bucket the new size gives it.
(fn counted ((upto i64)) -> (Map String i64)
  (let mut counts (empty-scores))
  (let mut index 0)
  (while (< index upto)
    (set counts (map-insert counts (key-for index) index))
    (set index (+ index 1)))
  counts)

(fn main () -> i32
  (let counts (counted 40))
  (println-i64 (map-size (& counts)))
  (println-i64 (map-fold (& counts) 0 add-up))
  (let present (key-for 37))
  (let absent (key-for 40))
  (println-i64 (unwrap-or (map-lookup (& counts) (& present)) (- 0 1)))
  (println-i64 (unwrap-or (map-lookup (& counts) (& absent)) (- 0 1)))

  ; A key inserted twice keeps the second value and does not grow the map, and
  ; the value it replaced is dropped with the entry that held it.
  (let mut notes (empty-notes))
  (set notes (map-insert notes 7 "seven"))
  (set notes (map-insert notes 8 "eight"))
  (set notes (map-insert notes 7 "SEVEN"))
  (println-i64 (map-size (& notes)))
  (let seven 7)
  (let found (unwrap-or (map-lookup (& notes) (& seven)) "none"))
  (println (& found))
  (set notes (map-delete notes (& seven)))
  (println-i64 (map-size (& notes)))
  (if (map-contains (& notes) (& seven))
    (println-i64 1)
    (println-i64 0))

  ; A set is a map whose values carry nothing, and `each` is its fold.
  (let mut names (empty-names))
  (set names (set-add names "ann"))
  (set names (set-add names "bo"))
  (set names (set-add names "ann"))
  (println-i64 (set-count (& names)))
  (println-i64 (set-each (& names) 0 longest))
  (let bo "bo")
  (set names (set-discard names (& bo)))
  (if (set-holds (& names) (& bo))
    (println-i64 1)
    (println-i64 0))
  (println-i64 (set-count (& names)))
  0)

(test "a key found after three rehashes is the one that was put there"
  (let counts (counted 40))
  (let key (key-for 39))
  (= 39 (unwrap-or (map-lookup (& counts) (& key)) (- 0 1))))

(test "inserting a key twice replaces the value and keeps the size"
  (let mut notes (empty-notes))
  (set notes (map-insert notes 1 "first"))
  (set notes (map-insert notes 1 "second"))
  (let one 1)
  (let held (unwrap-or (map-lookup (& notes) (& one)) "none"))
  (let want "second")
  (if (= 1 (map-size (& notes)))
    (equals (& held) (& want))
    false))

(test "deleting a key that was never there changes nothing"
  (let mut names (empty-names))
  (set names (set-add names "ann"))
  (let missing "zz")
  (set names (set-discard names (& missing)))
  (= 1 (set-count (& names))))

(test "a negative hash finds its bucket, and so does the smallest i64"
  (let mut marks (empty-marks))
  (let smallest (- 0 9223372036854775807))
  (set marks (map-insert marks (- smallest 1) 111))
  (set marks (map-insert marks 7 70))
  (let key (- smallest 1))
  (if (= 111 (unwrap-or (map-lookup (& marks) (& key)) 0))
    (= 2 (map-size (& marks)))
    false))
