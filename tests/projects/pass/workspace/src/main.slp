(take std:io println-i64)

(take helper:lib doubled)

(fn main () -> i32
  (println-i64 (foundation:numbers:forty))
  (println-i64 (doubled))
  0)

(test "a member of the same workspace is an ordinary dependency"
  (= (doubled) 80))

(test "the workspace shares one copy of foundation"
  (= (doubled) (+ (foundation:numbers:forty) (foundation:numbers:forty))))
