; A builder writes each piece into one buffer and allocates once (`D-145`).
; `concat` allocates a fresh string per piece and copies everything written so
; far, which is what made serializing a document quadratic.
(take std:builder Builder new write-str write-byte write-i64 write-u64 size build)
(take std:float write-f64)
(take std:io println println-i64)
(take std:string equals from-i64 from-u64 concat)
(take std:test equal-i64 equal-text)

(fn joined ((count i64)) -> String
  (let mut out (new))
  (let mut index 0)
  (while (< index count)
    (write-str &mut out &"item ")
    (write-i64 &mut out index)
    (write-byte &mut out 10)
    (set index (+ index 1)))
  (build out))

; The same document the other way, so the two can be compared for equality
; rather than for looking similar.
(fn concatenated ((count i64)) -> String
  (let mut out "")
  (let mut index 0)
  (while (< index count)
    (let number (from-i64 index))
    (let piece (concat &"item " &number))
    (let line (concat &piece &"\n"))
    (let next (concat &out &line))
    (set out next)
    (set index (+ index 1)))
  out)

(fn main () -> i32
  (let built (joined 3))
  (print built)
  (println-i64 (len &(joined 100)))
  0)

(fn print ((text String)) -> unit
  (println &text))

(test "a builder and a stack of concats agree"
  (let built (joined 40))
  (let copied (concatenated 40))
  (equal-text &built &copied))

(test "an empty builder builds an empty string"
  (let out (new))
  (equal-i64 (len &(build out)) 0))

(test "the size is the bytes written so far"
  (let mut out (new))
  (write-str &mut out &"abc")
  (write-byte &mut out 33)
  (equal-i64 (size &out) 4))

(test "an integer is written without a string per digit"
  (let mut out (new))
  (write-i64 &mut out 0)
  (write-byte &mut out 32)
  (write-i64 &mut out -9223372036854775808)
  (write-byte &mut out 32)
  (write-u64 &mut out 18446744073709551615)
  (equal-text &(build out) &"0 -9223372036854775808 18446744073709551615"))

(test "a float goes in through the module that formats one"
  (let mut out (new))
  (write-f64 &mut out 0.1)
  (equal-text &(build out) &"0.10000000000000001"))

(test "empty pieces leave empty and populated buffers alone"
  (let mut out (new))
  (write-str &mut out &"")
  (write-str &mut out &"prefix")
  (write-str &mut out &"")
  (and (= (size &out) 6) (equal-text &(build out) &"prefix")))

(test "bulk copies preserve NUL high bytes and UTF-8 after a prefix"
  (let mut out (new))
  (write-byte &mut out 62)
  (write-str &mut out &"a\0\x80\xffé0123456789")
  (write-str &mut out &"tail")
  (and (= (size &out) 21) (equal-text &(build out) &">a\0\x80\xffé0123456789tail")))

(test "repeated bulk copies survive growth and leave their source unchanged"
  (let mut out (new))
  (let piece "0123456789abcdef\0\xff")
  (let mut expected "")
  (let mut index 0)
  (while (< index 100)
    (write-str &mut out &piece)
    (set expected (concat &expected &piece))
    (set index (+ index 1)))
  (and (= (size &out) 1800)
       (equal-text &piece &"0123456789abcdef\0\xff")
       (equal-text &(build out) &expected)))

; The general string formatter is independent of the builder's digit path.
(fn unsigned-agrees ((value u64)) -> bool
  (let expected (from-u64 value))
  (let mut out (new))
  (write-str &mut out &"prefix:")
  (write-u64 &mut out value)
  (write-byte &mut out 33)
  (let width (size &out))
  (let decorated (concat &(concat &"prefix:" &expected) &"!"))
  (and (= width (len &decorated)) (equal-text &(build out) &decorated)))

(fn signed-agrees ((value i64)) -> bool
  (let expected (from-i64 value))
  (let mut out (new))
  (write-i64 &mut out value)
  (and (= (size &out) (len &expected)) (equal-text &(build out) &expected)))

(test "unsigned powers of ten and both neighbors preserve every digit"
  (let mut correct (unsigned-agrees 0))
  (let mut power (as u64 1))
  (let mut exponent 0)
  (while (< exponent 20)
    (set correct
      (and correct
           (unsigned-agrees (- power 1))
           (unsigned-agrees power)
           (unsigned-agrees (+ power 1))))
    (set exponent (+ exponent 1))
    ; The next power after 10^19 would overflow u64.
    (when (< exponent 20)
      (set power (* power 10))))
  (and correct (unsigned-agrees 18446744073709551615)))

(test "signed decimal boundaries agree on both sides of zero"
  (let mut correct (signed-agrees 0))
  (let mut power 1)
  (let mut exponent 0)
  (while (< exponent 19)
    (set correct
      (and correct
           (signed-agrees (- power 1))
           (signed-agrees power)
           (signed-agrees (+ power 1))
           (signed-agrees (- 0 (- power 1)))
           (signed-agrees (- 0 power))
           (signed-agrees (- 0 (+ power 1)))))
    (set exponent (+ exponent 1))
    (when (< exponent 19)
      (set power (* power 10))))
  (and correct (signed-agrees -9223372036854775808) (signed-agrees -9223372036854775807)
    (signed-agrees 9223372036854775806) (signed-agrees 9223372036854775807)))

(test "signed limits and consecutive writes have exact literal spelling"
  (let mut out (new))
  (write-i64 &mut out -9223372036854775808)
  (write-byte &mut out 32)
  (write-i64 &mut out 9223372036854775807)
  (write-byte &mut out 32)
  (write-i64 &mut out -1)
  (write-i64 &mut out 0)
  (write-u64 &mut out 1)
  (equal-text &(build out) &"-9223372036854775808 9223372036854775807 -101"))

(test "public packed construction preserves the same bytes and clone"
  (let mut out (Builder :words (list) :tail 65 :used 2))
  (let copied (clone out))
  (let fields-agree
    (match &out
      ((Builder :words words :tail tail :used used)
        (and (= (len words) 0) (= (clone tail) 65) (= (clone used) 2)))))
  (write-byte &mut out 255)
  (and fields-agree (equals &(build out) &"A\0\xff") (equals &(build copied) &"A\0")))

(test "public packed words and a partial tail finalize independently"
  (let out (Builder :words (list (as u64 0x4847464544434241)) :tail 0x4a49 :used 10))
  (let copied (clone out))
  (and (= (size &out) 10)
       (equals &(build out) &"ABCDEFGHIJ")
       (equals &(build copied) &"ABCDEFGHIJ")))

(test "a built clone owns its bytes while the original keeps growing"
  (let mut original (new))
  (write-str &mut original &"ABCDEFGH\0\xff")
  (let snapshot (build (clone original)))
  (write-str &mut original &"é")
  (and (= (size &original) 12)
       (equals &snapshot &"ABCDEFGH\0\xff")
       (equals &(build original) &"ABCDEFGH\0\xffé")
       (equals &snapshot &"ABCDEFGH\0\xff")))

(test "a word view ends before the owner grows again"
  (let mut out (new))
  (write-str &mut out &"abcdefgh")
  (let first
    (match &out
      ((Builder :words words :tail _ :used _)
        (let view (slice words 0 (len words)))
        (get &view 0))))
  (write-str &mut out &"ijklmnop")
  (and (= first (as u64 0x6867666564636261)) (equals &(build out) &"abcdefghijklmnop")))
