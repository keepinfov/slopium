; How a declaration is annotated (`D-122`): a list written between a
; declaration's keyword and its name. The slot ends at the name, so nothing a
; declaration could already write became ambiguous, and every future annotation
; — `repr` on a foreign record, `interrupt` on a handler — costs no grammar.
(take std:io println println-i64)
(take std:string from-i64 concat)
(take legacy widen retry-limit Reading)

; `inline` is a hint to the optimizer and nothing more: a body worth copying
; into its callers. Everything that decides whether inlining is *sound* — the
; module boundary, recursion, the C boundary — is still the optimizer's, so the
; annotation cannot make this program mean anything else.
;
;; Mixes two numbers, slowly enough to be worth a look at whether it inlined.
;; A `;;` block above a declaration is documentation (`D-134`), and it sits
;; above the annotation slot rather than inside it.
(fn (inline) blend ((a i64) (b i64)) -> i64
  (let one (+ a b))
  (let two (* one 3))
  (let three (- two a))
  (let four (+ three b))
  (let five (* four 2))
  (let six (- five 1))
  (let seven (+ six a))
  (let eight (* seven 2))
  (- eight b))

(fn mixed ((n i64)) -> i64
  (+ (blend n 3) (blend n 4)))

; A hinted body that owns what it builds, so the release profile copies drop
; elaboration into its caller rather than only arithmetic: a body inlined
; wrong here is a double free or a leak, and neither is a type error.
(fn (inline) decorated ((n i64)) -> String
  (let mark "#")
  (let digits (from-i64 n))
  (let one (concat &mark &digits))
  (let two (concat &one &mark))
  (let three (concat &two &digits))
  (let four (concat &three &mark))
  (let five (concat &four &digits))
  (concat &five &mark))

(fn label ((n i64)) -> String
  (decorated n))

; An annotation name reserves nothing: `inline` is special in the slot and is
; an ordinary name everywhere else, which is what this binding is here to say.
(fn ordinary-names () -> i64
  (let inline 4)
  (let deprecated 5)
  (+ inline deprecated))

; A field name appears at exactly three places and each of them warns: a read,
; a construction, and a pattern — through which a write goes, so there is no
; fourth (`D-152`). The healthy field beside it says nothing.
(fn warmer ((reading Reading)) -> i64
  (let built (Reading :degrees 20 :celsius 20 :label "outside"))
  (let read-back (. built degrees))
  (match reading
    ((Reading :degrees degrees :celsius celsius :label label)
      (+ (+ read-back degrees) celsius|)

; Two uses of one deprecated function, so the warning is per use rather than
; per declaration, and one use of a deprecated `const`.
(fn main () -> unit
  (println-i64 (mixed 2))
  (println-i64 (ordinary-names))
  (println-i64 (+ (widen 20) (widen 22)))
  (println-i64 retry-limit)
  (let name (label 8))
  (println &name)
  (println-i64 (warmer (Reading :degrees 1 :celsius 2 :label "inside"|)
