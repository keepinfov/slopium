(take std:io println)

; A write past the end is a bounds check like every read past the end, and it
; happens before the slot is touched, so nothing has been half-moved when it
; fails (`D-103`).
(fn main () -> i32
  (let mut values (list "one"))
  (let displaced (replace &mut values 2 "three"))
  (println &displaced)
  0)

(test "fixture compiles" true)
